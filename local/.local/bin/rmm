#!/usr/bin/env bash

######################################################################
#             Select multiple files in fzf and trash it              #
######################################################################
results=$(fzf -m --border-label="╣ Trash multiple files ╠" --header="Tab to select, Ctrl-C to cancel")
[[ -z "$results" ]] && exit 0

files=()
while IFS= read -r line; do
    [[ -n "$line" ]] && files+=("$line")
done <<<"$results"

echo "trash ${files[*]}"
trash "${files[@]}"
