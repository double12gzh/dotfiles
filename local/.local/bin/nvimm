#!/usr/bin/env bash

######################################################################
#          Select multiple files in fzf and open with nvim           #
######################################################################
results=$(fzf -m --border-label="╣ Open multiple files with Neovim ╠" --header="Tab to select, Ctrl-C to cancel")
[[ -z "$results" ]] && exit 0

files=()
while IFS= read -r line; do
    [[ -n "$line" ]] && files+=("$line")
done <<<"$results"

echo "nvim ${files[*]}"
nvim "${files[@]}"
