#!/usr/bin/env bash

######################################################################
#         Select multiple files in fzf and move to given dir         #
######################################################################
results=$(fzf -m --border-label="╣ Move multiple files ╠" --header="Tab to select, Ctrl-C to cancel")
[[ -z "$results" ]] && exit 0

while IFS= read -r f; do
    [[ -n "$f" ]] && mv "$f" "$1"
done <<<"$results"
