#!/usr/bin/env bash

######################################################################
#                  Pipe `tmux ls` to fzf and attach                  #
######################################################################
fzf_tat=$(
    tmux list-sessions -F "#{session_name}" | fzf \
        --border-label="╣ Tmux Attach ╠" \
        --header="Enter to attach, Ctrl-C to cancel"
)
for s in $fzf_tat; do
    if [ -n "${TMUX:-}" ]; then
        tmux switch-client -t "$s"
    else
        tmux attach-session -t "$s"
    fi
done
