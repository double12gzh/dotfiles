#!/usr/bin/zsh

# Deduplicate PATH and fpath automatically
typeset -U path PATH fpath FPATH

# Prevent system-wide /etc/zshrc from running compinit prematurely (Ubuntu/Debian)
skip_global_compinit=1

# Add Homebrew bin to PATH on macOS
if [[ "$OSTYPE" == darwin* ]]; then
    path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
fi

# XDG & Locale & Editor environment variables
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR='nvim'
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"

# Program languages PATH & env
export LUA_LIBRARY="$HOME/tools/luajit/src/libluajit.so"
export PERL_CPANM_HOME="$HOME/tools/cpanm"
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Conda base environment variables & PATH
if [[ -d "$HOME/tools/miniconda" ]]; then
    export CONDA_PREFIX="$HOME/tools/miniconda"
elif [[ -d "$HOME/tools/anaconda" ]]; then
    export CONDA_PREFIX="$HOME/tools/anaconda"
fi

# Prepend existing tool directories to PATH
for _tool_dir in \
    "$HOME/tools/golang/bin" \
    "$HOME/go/bin" \
    "$HOME/tools/java/bin" \
    "$HOME/tools/julia/bin" \
    "$HOME/tools/lua/src" \
    "$HOME/tools/luajit/src" \
    "$HOME/tools/luarocks/bin" \
    "$HOME/tools/luarocks" \
    "$HOME/tools/nodejs/bin" \
    "$HOME/tools/perl/bin" \
    "$HOME/tools/php/bin" \
    "$HOME/tools/ruby/bin" \
    "$HOME/.bin" \
    "$HOME/.local/bin" \
    "$HOME/tools/btop/bin" \
    "$HOME/tools/cpufetch" \
    "$HOME/tools/fzf/bin" \
    "$HOME/tools/fzy" \
    "$HOME/tools/jq" \
    "$HOME/tools/lnav" \
    "$HOME/tools/nvim/bin" \
    "$HOME/tools/tmux/bin" \
    "$HOME/tools/tmux" \
    "$HOME/tools/treesitter" \
    "$HOME/tools/ugrep/bin" \
    "$HOME/tools/qfc/bin" \
    "$HOME/tools/miniconda/bin" \
    "$HOME/tools/anaconda/bin"
do
    [[ -d "$_tool_dir" ]] && path=("$_tool_dir" $path)
done
unset _tool_dir

# Linux-specific environment variables
if [[ "$OSTYPE" == linux* ]]; then
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/usr/local/lib"
    # Fcitx5 env
    export GTK_IM_MODULE=fcitx
    export QT_IM_MODULE=fcitx
    export QT5_IM_MODULE=fcitx
    export SDL_IM_MODULE=fcitx
    export XMODIFIERS=@im=fcitx
fi
