# Standalone full-featured Zsh configuration (auto-detects optional tools)
# Usage: scp ~/.zsh/standalone/zshrc.standalone user@host:~/.zshrc

typeset -U path PATH fpath FPATH

# Enable colors and change prompt:
autoload -U colors && colors
PS1="%B%{$fg[red]%}[%{$fg[yellow]%}%n%{$fg[green]%}@%{$fg[blue]%}%M %{$fg[magenta]%}%~%{$fg[red]%}]%{$reset_color%}$%b "

# History in cache directory:
HISTSIZE=10000
SAVEHIST=10000
if [[ -d "/cwaidev/000GZH" ]]; then
    [[ -d "/cwaidev/000GZH/.cache/zsh" ]] || mkdir -p "/cwaidev/000GZH/.cache/zsh"
    HISTFILE="/cwaidev/000GZH/.cache/zsh/history"
else
    [[ -d "$HOME/.cache/zsh" ]] || mkdir -p "$HOME/.cache/zsh"
    HISTFILE="$HOME/.cache/zsh/history"
fi
# 实时追加与多终端共享历史记录
setopt inc_append_history
setopt share_history
setopt hist_ignore_dups

[[ -d ~/.zfunc ]] && fpath=(~/.zfunc $fpath)

# Basic auto/tab complete:
autoload -Uz compinit
zstyle ':completion:*' menu select
zmodload zsh/complist
compinit
_comp_options+=(globdots)               # Include hidden files.

# vi mode
export KEYTIMEOUT=1
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# Use vim keys in tab complete menu:
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -v '^?' backward-delete-char

bindkey  "^[[H"   beginning-of-line
bindkey  "^[[F"   end-of-line
bindkey  "^[[2~"  vi-insert
bindkey  "^[[3~"  delete-char
bindkey  "^A"     beginning-of-line
bindkey  "^E"     end-of-line
bindkey  "^P"     up-line-or-search
bindkey  "^N"     down-line-or-search
bindkey  "^R"     history-incremental-search-backward

# Edit line in vim with ctrl-o:
autoload edit-command-line; zle -N edit-command-line
bindkey '^o' edit-command-line

for _tool_dir in \
    "$HOME/tools/treesitter" \
    "$HOME/tools/lua/src" \
    "$HOME/tools/luarocks" \
    "$HOME/tools/luajit/src" \
    "$HOME/tools/nodejs/bin" \
    "$HOME/.cargo/bin" \
    "$HOME/tools/miniconda/bin" \
    "$HOME/.local/bin" \
    "$HOME/tools/nvim/bin" \
    "$HOME/.bin" \
    "$HOME/.go/go/bin"
do
    [[ -d "$_tool_dir" ]] && path=("$_tool_dir" $path)
done
unset _tool_dir

(( $+commands[kubectl] )) && source <(kubectl completion zsh)
if (( $+commands[fzf] )) && fzf --zsh &>/dev/null; then
    source <(fzf --zsh)
elif [[ -f ~/.fzf.zsh ]]; then
    source ~/.fzf.zsh
fi

# Load aliases and shortcuts if existent.
[[ -f "$HOME/.alias" ]] && source "$HOME/.alias"
[[ -f "/cwaidev/000GZH/.alias" ]] && source "/cwaidev/000GZH/.alias"
[[ -f "/cwaidev/000GZH/.zsh/fzf-tab.zsh" ]] && source "/cwaidev/000GZH/.zsh/fzf-tab.zsh"

if (( $+commands[go] )); then
    export GOPROXY='https://goproxy.cn,direct'
    [[ -d "/cwaidev/000GZH" ]] && export GOPATH='/cwaidev/000GZH/.gopath'
fi

export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow'
export FZF_DEFAULT_OPTS='--ansi --height 40% --layout=reverse --border=double --border-label="╣ FZF ╠" --header="E to edit" --preview="pistol {}" --bind="E:execute(vim {})" --preview-label="┓ ⟪Preview⟫ ┏" --preview-window=right,border-bold --color=border:#7ba46c,label:#7ba46c'
export FZF_CTRL_T_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
export FZF_CTRL_R_OPTS='--height 40% --layout=reverse --border=double --border-label="╣ History ╠" --preview-window=hidden --no-preview'
export FZF_CTRL_T_OPTS="$FZF_DEFAULT_OPTS"
export FZF_ALT_C_COMMAND='fd -H --type d . --color=never'
export FZF_ALT_C_OPTS="$FZF_DEFAULT_OPTS"

[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

export LUA_LIBRARY="$HOME/tools/luajit/src/libluajit.so"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/usr/local/lib"

if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh)"
fi
# if (( $+commands[starship] )); then
#     eval "$(starship init zsh)"
# fi
